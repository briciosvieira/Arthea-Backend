generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  name         String
  login        String   @unique
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointmentsCreated Appointment[] @relation("AppointmentsCreatedBy")
}

model Doctor {
  id        String   @id @default(cuid())
  name      String
  crm       String   @unique
  specialty String   // função ou especialidade
  about     String?
  photoUrl  String?
  active    Boolean  @default(true)
  hiredAt   DateTime @default(now())

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  patientName String
  patientCPF  String
  patientRG   String?
  description String
  startAt     DateTime

  doctor   Doctor @relation(fields: [doctorId], references: [id])
  doctorId String

  createdBy   User?    @relation("AppointmentsCreatedBy", fields: [createdById], references: [id])
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, startAt])
}

enum HeroType {
  VIDEO
  IMAGE
}

enum SliderSection {
  RECEPCAO
  CONSULTORIO
}

model HeroMedia {
  id        String   @id @default(uuid())
  type      HeroType @default(VIDEO)
  videoPath String?
  imagePath String?
  updatedAt DateTime @updatedAt
}

model SliderImage {
  id        String        @id @default(uuid())
  section   SliderSection
  filePath  String
  active    Boolean       @default(true)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model QuemSomosImage {
  id        String   @id @default(uuid())
  position  Int      @unique
  filePath  String
  updatedAt DateTime @updatedAt
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @db.VarChar(80)
  createdAt   DateTime @default(now())
}

enum SocialType {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  YOUTUBE
  TIKTOK
  TWITTER
  ADDRESS
  OTHER
}

model SocialLink {
  id        String     @id @default(uuid())
  type      SocialType
  label     String?
  value     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}